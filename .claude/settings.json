{
  "permissions": {
    "ask": [
      "Bash(rm -rf *)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune *)",
      "Bash(dropdb *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-destructive.sh\"",
            "timeout": 10,
            "statusMessage": "파괴적 명령 검사"
          }
        ]
      }
    ]
  }
}
